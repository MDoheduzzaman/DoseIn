<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="rootPane" prefHeight="600" prefWidth="749.0" styleClass="dashboard-root" stylesheets="@../css/dashboard.css,@../css/set_reminder.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.momentum.dosein.controller.SetReminderController">

    <!-- Left Navigation -->
    <left>
        <VBox prefWidth="220" spacing="10" styleClass="nav-bar">
            <HBox alignment="CENTER_LEFT" prefHeight="60" spacing="10" styleClass="nav-header">
                <ImageView fitHeight="37.0" fitWidth="43.0" preserveRatio="true">
                    <image><Image url="@../images/logo.png" /></image>
               <HBox.margin>
                  <Insets left="2.0" />
               </HBox.margin>
                </ImageView>
                <Label styleClass="project-name" text="DoseIn" />
            </HBox>
            <Button onAction="#handleDashboard" prefHeight="45.0" prefWidth="200.0" styleClass="left-button" text="Dashboard">
            <padding>
               <Insets bottom="10.0" top="10.0" />
            </padding></Button>
            <Button onAction="#handleManageSchedule" prefHeight="45.0" prefWidth="200.0" styleClass="left-button" text="Manage Schedule">
            <padding>
               <Insets bottom="10.0" top="10.0" />
            </padding></Button>
            <Button onAction="#handleDoctorContacts" prefHeight="45.0" prefWidth="200.0" styleClass="left-button" text="Doctor Contacts">
            <padding>
               <Insets bottom="10.0" top="10.0" />
            </padding></Button>
            <Button onAction="#handleEmergency" prefHeight="45.0" prefWidth="200.0" styleClass="left-button" text="Emergency">
            <padding>
               <Insets bottom="10.0" top="10.0" />
            </padding></Button>
            <Button onAction="#handleAboutUs" prefHeight="45.0" prefWidth="200.0" styleClass="left-button" text="About Us">
            <padding>
               <Insets bottom="10.0" top="10.0" />
            </padding></Button>
            <Region VBox.vgrow="ALWAYS" />
            <Button onAction="#handleSignOut" prefHeight="45.0" prefWidth="200.0" styleClass="sign-out" text="Sign Out">
            <padding>
               <Insets bottom="10.0" top="10.0" />
            </padding></Button>
        </VBox>
    </left>

    <center>
        <VBox alignment="CENTER" maxWidth="600.0" prefHeight="559.0" prefWidth="485.0" spacing="0" styleClass="reminder-root">
            <VBox fx:id="cardBox" alignment="TOP_CENTER" layoutX="1.0" layoutY="1.0" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="566.0" prefWidth="464.0" spacing="24" styleClass="reminder-card" stylesheets="@../css/set_reminder.css">
                <padding>
                    <Insets bottom="35" left="35" right="35" top="35" />
                </padding>

                <!-- Title -->
                <Label styleClass="set-reminder-title" stylesheets="@../css/set_reminder.css" text="Add Medicine Information" />

                <!-- Name & Dates (compact form) -->
                <GridPane hgap="15" styleClass="time-date" stylesheets="@../css/set_reminder.css" vgap="15">
                    <children>
                        <Label styleClass="reminder-level" stylesheets="@../css/set_reminder.css" text="Name :" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                        <TextField fx:id="nameField" prefHeight="62.0" prefWidth="175.0" styleClass="reminder-field" stylesheets="@../css/set_reminder.css" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                        <Label styleClass="reminder-level" text="Start Date :" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                        <DatePicker fx:id="startDatePicker" prefHeight="66.0" prefWidth="175.0" styleClass="reminder-field" stylesheets="@../css/set_reminder.css" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                        <Label styleClass="reminder-level" text="End Date :" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                        <DatePicker fx:id="endDatePicker" prefHeight="38.0" prefWidth="175.0" styleClass="reminder-field" stylesheets="@../css/set_reminder.css" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                    </children>
                    <columnConstraints>
                        <ColumnConstraints />
                        <ColumnConstraints />
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints />
                        <RowConstraints />
                        <RowConstraints />
                    </rowConstraints>
                </GridPane>

                <!-- Alert Time Card -->
                <VBox alignment="TOP_LEFT" prefHeight="129.0" prefWidth="423.0" spacing="12" styleClass="reminder-mini-card" stylesheets="@../css/set_reminder.css">
                    <padding>
                        <Insets bottom="5.0" top="5.0" />
                    </padding>
                    <Label styleClass="set-reminder-title" stylesheets="@../css/set_reminder.css" text="Alert Time" />
                    <HBox alignment="TOP_LEFT" spacing="16">
                        <!-- Time List -->
                        <ListView fx:id="timesList" styleClass="reminder-list" stylesheets="@../css/set_reminder.css" />
                        <!-- Spinner + AM/PM -->
                        <VBox alignment="CENTER" spacing="7">
                            <HBox alignment="CENTER" spacing="5">
                                <Spinner fx:id="hourSpinner" editable="true" />
                                <Label text=":" />
                                <Spinner fx:id="minuteSpinner" editable="true" prefHeight="23.0" />
                            </HBox>
                            <HBox alignment="CENTER" spacing="6">
                                <RadioButton fx:id="amRadio" styleClass="am" stylesheets="@../css/set_reminder.css" text="AM" />
                                <RadioButton fx:id="pmRadio" styleClass="pm" stylesheets="@../css/set_reminder.css" text="PM" />
                            </HBox>
                        </VBox>
                        <!-- Add/Remove Buttons -->
                        <VBox alignment="CENTER" spacing="7">
                            <Button fx:id="addTimeButton" onAction="#handleAddTime" prefHeight="23.0" prefWidth="37.0" styleClass="add" stylesheets="@../css/set_reminder.css" text="Add" />
                            <Button fx:id="removeTimeButton" onAction="#handleRemoveTime" prefHeight="30.0" prefWidth="40.0" styleClass="remove" stylesheets="@../css/set_reminder.css" text="Remove" />
                        </VBox>
                    </HBox>
                </VBox>

                <!-- Additional Info -->
                <Label prefHeight="39.0" prefWidth="366.0" styleClass="set-reminder-title" stylesheets="@../css/set_reminder.css" text="Additional Information :" />
                <TextField fx:id="noteField" minHeight="-Infinity" minWidth="-Infinity" prefHeight="38.0" prefWidth="394.0" stylesheets="@../css/set_reminder.css" />

                <!-- Bottom Action Buttons -->
                <HBox alignment="CENTER" prefHeight="77.0" prefWidth="394.0" spacing="18">
                    <Button maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" onAction="#handleCancel" prefHeight="40.0" prefWidth="121.0" styleClass="cancel-button" text="Cancel" />
                    <Button maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" onAction="#handleSetReminder" prefHeight="25.0" prefWidth="129.0" styleClass="set-reminder-button" text="Set Reminder" />
                </HBox>
            </VBox>
        </VBox>
    </center>
</BorderPane>
