<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="rootPane" prefHeight="600" prefWidth="800" styleClass="dashboard-root" stylesheets="@../css/dashboard.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.momentum.dosein.controller.DashboardController">

    <!-- LEFT NAVIGATION -->
    <left>
        <VBox prefHeight="600.0" prefWidth="227.0" spacing="10" styleClass="nav-bar">
            <!-- make the logo/header clickable -->
            <HBox fx:id="navHeader" alignment="CENTER_LEFT" onMouseClicked="#handleDashboard" prefHeight="60" spacing="10" styleClass="nav-header">
                <ImageView fitHeight="30" fitWidth="30" preserveRatio="true">
                    <image>
                        <Image url="@../images/logo.png" />
                    </image>
                </ImageView>
                <Label styleClass="nav-logo" text="DoseIn" />
            </HBox>
            <Button onAction="#handleDashboard" prefHeight="45.0" prefWidth="200.0" styleClass="left-button" text="Dashboard">
            <padding>
               <Insets bottom="10.0" top="10.0" />
            </padding></Button>
            <Button onAction="#handleManageSchedule" prefHeight="45.0" prefWidth="200.0" styleClass="left-button" text="Manage Schedule">
            <padding>
               <Insets bottom="10.0" top="10.0" />
            </padding></Button>
            <Button onAction="#handleDoctorContacts" prefHeight="45.0" prefWidth="200.0" styleClass="left-button" text="Doctor Contacts">
            <padding>
               <Insets bottom="10.0" top="10.0" />
            </padding></Button>
            <Button onAction="#handleEmergency" prefHeight="45.0" prefWidth="200.0" styleClass="left-button" text="Emergency">
            <padding>
               <Insets bottom="10.0" top="10.0" />
            </padding></Button>
            <Button onAction="#handleAboutUs" prefHeight="45.0" prefWidth="200.0" styleClass="left-button" text="About Us">
            <padding>
               <Insets bottom="10.0" top="10.0" />
            </padding></Button>
            <Region VBox.vgrow="ALWAYS" />
            <Button onAction="#handleSignOut" prefHeight="45.0" prefWidth="200.0" styleClass="sign-out" text="Sign Out">
            <padding>
               <Insets bottom="10.0" top="10.0" />
            </padding></Button>
        </VBox>
    </left>

    <!-- CENTER CONTENT -->
    <center>
        <VBox spacing="20" styleClass="main-content">

            <!-- Welcome Banner -->
            <HBox alignment="CENTER_LEFT" spacing="10" styleClass="welcome-banner">
                <VBox>
                    <Label fx:id="greetingLabel" styleClass="welcome-text" />
                    <Label fx:id="sloganLabel" styleClass="welcome-slogan" />
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="timeLabel" styleClass="time-label" />
            </HBox>

            <!-- Schedule Header -->
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label styleClass="schedule-header" text="Today's Schedule" />
                <Region HBox.hgrow="ALWAYS" />
                <Button onAction="#handleSetReminder" styleClass="schedule-button" text="Set Reminder" />
            </HBox>

            <!-- Scrollable Schedule List -->
            <ScrollPane fitToWidth="true" styleClass="schedule-scroll">
                <content>
                    <VBox fx:id="scheduleContainer" spacing="10" styleClass="schedule-list" />
                </content>
            </ScrollPane>
         <padding>
            <Insets left="10.0" right="10.0" />
         </padding>
        </VBox>
    </center>
</BorderPane>
